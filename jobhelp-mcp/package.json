{
  "name": "@jeffreyp1/jobhelp-mcp",
  "version": "0.2.0",
  "description": "JobHelp MCP server: zero-API-key job discovery, ranking, and tailoring context for any MCP-compatible client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffreyp1/JobHelp.git"
  },
  "bugs": {
    "url": "https://github.com/jeffreyp1/JobHelp/issues"
  },
  "homepage": "https://github.com/jeffreyp1/JobHelp#readme",
  "type": "module",
  "private": false,
  "files": [
    "company-lists/",
    "mcp/dist/",
    "prompts-bundle/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "jobhelp-mcp": "./mcp/dist/mcp/src/bin.js"
  },
  "exports": {
    ".": "./mcp/dist/core/index.js",
    "./types": "./mcp/dist/core/types/index.js",
    "./mcp": "./mcp/dist/mcp/src/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('mcp/dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x mcp/dist/mcp/src/bin.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jobs",
    "job-search",
    "resume",
    "tailoring",
    "claude",
    "anthropic"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^0.5.0"
  }
}
