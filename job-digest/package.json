{
  "name": "@jeffreyp1/jobhelp-mcp",
  "version": "0.2.0-alpha.0",
  "description": "JobHelp MCP server: zero-API-key job discovery, ranking, and tailoring context for any MCP-compatible client",
  "type": "module",
  "private": true,
  "bin": {
    "jobhelp-mcp": "./mcp/dist/mcp/src/bin.js"
  },
  "exports": {
    ".": "./core/index.ts",
    "./types": "./core/types/index.ts",
    "./mcp": "./mcp/src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@modelcontextprotocol/sdk": "^0.5.0"
  }
}
