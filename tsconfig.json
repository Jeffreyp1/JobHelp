{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"]
  },
  "include": ["extension/src/**/*", "extension/tests/**/*", "appsscript/src/**/*", "appsscript/tests/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
