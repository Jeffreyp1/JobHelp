{
  "manifest_version": 3,
  "name": "JobHelp",
  "version": "0.3.0",
  "description": "Tailor resumes to job descriptions with optional research, critique, cover letter, and multi-version generation.",
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://boards.greenhouse.io/*",
        "*://job-boards.greenhouse.io/*"
      ],
      "js": ["autofill.content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "JobHelp"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
