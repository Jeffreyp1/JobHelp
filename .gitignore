job-digest/scripts/companies-report.md

# Local user-specific Claude / extension config (contains permissioned commands list,
# may contain personal paths — not appropriate for a shared repo)
# Blanket ignore .claude/ catches scheduled_tasks.lock + auto-generated karen agents.
# Intentionally-shared project agents/commands/skills already tracked stay tracked
# (gitignore doesn't untrack); use `git add -f` for new intentional additions.
.claude/
.claude-mem/

# Superpowers brainstorming sessions (HTML mockups, server state, never share)
.superpowers/

# Personal job-search artifacts (NEVER commit — these contain real resume, scraped JDs, etc.)
resume-dump/
out/
job-descriptions/
experiments/
docs/research/

# Scratch dirs used by sub-agents as Write-tool sandbox workaround
.scratch-*/

# Source maps for built bundles (generated, not source of truth)
extension/public/**/*.js.map
extension/public/scraper.bundle.js.map
extension/public/background.js.map
appsscript/dist/*.map

# Output of test runs
coverage/
.nyc_output/

# Built extension bundles — they're regenerated by `node extension/scripts/build.mts`
# Comment these out if you want to ship a pre-built extension via the repo.
# extension/public/background.js
# extension/public/scraper.bundle.js
# extension/public/sidepanel/index.js

# Apps Script clasp working files (if user adds clasp later)
.clasp.json
.clasprc.json

# Logs
*.log
npm-debug.log*

# tmp
*.tmp
*.swp

# job-digest build outputs
job-digest/mcp/dist/
job-digest/dist/

# Tests — maintained locally only, NOT pushed to GitHub
# (test data in tests/fixtures/ is kept; only test code is excluded)
appsscript/tests/
extension/tests/
job-digest/tests/
tests/contracts/
tests/smoke/
tests/local/
tests/fixtures/_validate.test.ts

# Superpowers planning/spec docs — maintained locally only
docs/superpowers/plans/
docs/superpowers/specs/2026-05-17-resume-tailor-validator-design.md
prompts/shared/_validate.test.ts
**/*.test.ts
**/*.test.mts
**/*.test.js
**/*.spec.ts
