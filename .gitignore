# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Editor / OS
.DS_Store
.vscode/
.idea/

# Local env / secrets
.env
.env.local
.env.*.local
jobhelp-config.json

# Local/private AI workflow artifacts
.local/
.codex/
.agents/
jobhelp-mcp/scripts/companies-all.json
jobhelp-mcp/scripts/companies-report.md
jobhelp-mcp/scripts/*-report.md
jobhelp-mcp/scripts/*-slugs.json
jobhelp-mcp/scripts/*-tokens.json

# Local user-specific Claude / extension config (contains permissioned commands list,
# may contain personal paths — not appropriate for a shared repo)
# Blanket ignore .claude/ catches scheduled_tasks.lock + auto-generated karen agents.
# Intentionally-shared project agents/commands/skills already tracked stay tracked
# (gitignore doesn't untrack); use `git add -f` for new intentional additions.
.claude/
.claude-mem/

# Superpowers brainstorming sessions (HTML mockups, server state, never share)
.superpowers/

# Personal job-search artifacts (NEVER commit — these contain real resume, scraped JDs, etc.)
/applications/
/digests/
/resumes/
/state.json
/resume-dump/
/out/
/job-descriptions/
/experiments/
/docs/research/

# Auto-apply run artifacts (personal answers, per-job status, location/gap logs)
/answer-bank.json
/autoapply-*.json
/autoapply-*.jsonl

# Root-level images are filled-application screenshots and fixture captures
# (root-anchored: extension icons under extension-app/ are unaffected)
/*.png
/*.jpg
/*.jpeg

# Dev-session journals (contain bio: school, grad year, skills, target companies)
/docs/timeline-weeks/

# Local caches and generated graph output
/cache/
/graphify-out/

# Scratch dirs used by sub-agents as Write-tool sandbox workaround
.scratch-*/
/.scratch/

# Source maps for built bundles (generated, not source of truth)
extension-app/extension/public/**/*.js.map
extension-app/extension/public/scraper.bundle.js.map
extension-app/extension/public/background.js.map
extension-app/appsscript/dist/*.map

# Output of test runs
coverage/
.nyc_output/

# Built extension bundles — they're regenerated by `node extension-app/extension/scripts/build.mts`
# Comment these out if you want to ship a pre-built extension via the repo.
# extension-app/extension/public/background.js
# extension-app/extension/public/scraper.bundle.js
# extension-app/extension/public/sidepanel/index.js

# Apps Script clasp working files (if user adds clasp later)
.clasp.json
.clasprc.json

# Logs
*.log
npm-debug.log*

# tmp
*.tmp
*.swp

# jobhelp-mcp build outputs
jobhelp-mcp/mcp/dist/
jobhelp-mcp/dist/

# Legacy tests stay local-only unless explicitly re-included below.
# jobhelp-mcp tests are visible for MCP regression coverage; two sidepanel tests are visible for UI selection coverage.
extension-app/appsscript/tests/
extension-app/extension/tests/
jobhelp-mcp/tests/
extension-app/tests/contracts/*
extension-app/tests/smoke/
extension-app/tests/local/
extension-app/tests/fixtures/_validate.test.ts

# Superpowers planning/spec docs — maintained locally only
docs/superpowers/plans/
docs/superpowers/specs/
extension-app/prompts/shared/_validate.test.ts
**/*.test.ts
**/*.test.mts
**/*.test.js
**/*.spec.ts
!jobhelp-mcp/tests/
!jobhelp-mcp/tests/**
!extension-app/tests/sidepanel/
!extension-app/tests/sidepanel/resumeEditor-selection.test.ts
!extension-app/tests/sidepanel/generate-whole-resume-revise-safety.test.ts
!extension-app/tests/contracts/
!extension-app/tests/contracts/configLoader.test.ts
!extension-app/tests/contracts/verify-bundle-actions.test.ts
!autoapply/engine/tests/
!autoapply/engine/tests/**
