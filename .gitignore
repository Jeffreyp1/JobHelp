# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Editor / OS
.DS_Store
.vscode/
.idea/

# Local env / secrets
.env
.env.local
.env.*.local
jobhelp-config.json

# Local/private AI workflow artifacts
.codex/
.agents/
